DATABASE_URL=postgres://user:password@localhost:5432/portside
JWT_SECRET=change-me
PORT=4000
FRONTEND_URL=http://localhost:5173

# Boosted posts (see /membership) go through Stripe Checkout. Get these from
# the Stripe dashboard - without them, POST /posts/:id/boost returns a 503
# rather than silently accepting an unpaid boost.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
